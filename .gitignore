# ==========================================
# 选刊助手（Wenjin-Lens）生产级忽略规则
# ==========================================

# 1. 绝对防御：敏感配置文件与密钥凭据（严禁上传）
.env
.env.*
!.env.example
config.json
config/config.json
api.txt
*api*.txt
*.key
*.token
credentials.json
.wrangler/
wrangler.state/
*.dev.vars
.agent/


# 2. 个人隐私数据：学术选刊决策台账（避免泄漏个人选刊历史）
journal_track.csv
journal_track.xlsx
data/track/journal_track.csv
data/track/journal_track.xlsx
data/track/journal_track.*
*.xlsx.tmp

# 3. Python 运行时与缓存临时文件
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
dist/
*.spec
*.egg-info/
.eggs/

# 4. 测试与覆盖率产物
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# 5. 日志与调试文件
*.log
logs/

# 6. 编辑器与系统临时文件
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# 7. 本地参考资料库与设计规范（避免向主仓库提交外部嵌套 Git 库）
references/
tuiwen_journal_strategy/
