# ==========================================
# 文津·选刊助手 (Wenjin-Lens) 环境变量配置模板
# ==========================================
# 复制此文件为 .env 并根据部署环境按需调整

# 服务运行网络与端口
HOST=0.0.0.0
PORT=8000
WORKERS=2

# Google AI Studio (Gemini) API Key
# 用于联网核验与办刊宗旨语义深度查证（选填，未配置时自动降级为离线与开放API模式）
GEMINI_API_KEY=

# Gemini API 反向代理地址（如使用 Cloudflare Worker 免翻墙反代，推荐国内云服务器配置）
# GEMINI_BASE_URL=https://wenjin-gemini-proxy.your-subdomain.workers.dev

# 网络代理配置（如处于特定内网或需要代理访问 Gemini API）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
